APP_NAME=Camargoflix
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080

# Banco MySQL externo (hospedagem/nuvem). Crie o banco vazio e rode: php bin/migrate.php --seed
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# SSL (exigido por vários provedores em nuvem). DB_SSL_CA = caminho do certificado, se o provedor fornecer um
DB_SSL=false
DB_SSL_CA=
DB_SSL_VERIFY=true

# Só para o MySQL local opcional (docker compose --profile local-db up)
DB_ROOT_PASSWORD=root

# Pasta onde ficam os arquivos de vídeo (montada em /var/www/html/media)
MEDIA_PATH=./media

# Login com Google (https://console.cloud.google.com/apis/credentials → OAuth client ID → Web application)
# URI de redirecionamento autorizado: http://localhost:8080/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Contas que podem entrar (separe por vírgula). As demais são recusadas.
# URI de retorno do login Google: uma para o ambiente local e outra para produção (cadastre as duas no Google Cloud).
# O app escolhe sozinho: acesso por localhost → LOCAL; pelo domínio → PRODUCTION.
GOOGLE_REDIRECT_URI_LOCAL=http://localhost:8080/auth/google/callback
GOOGLE_REDIRECT_URI_PRODUCTION=https://fin.toncamargo.com.br/auth/google/callback
# E-mails liberados (separados por vírgula). Vazio = qualquer conta Google pode entrar.
ALLOWED_EMAILS=

# Fonte dos dados: database = dados reais | demo = dados de teste do template
DATA_SOURCE=database
