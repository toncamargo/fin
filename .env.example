# Copie para .env (local: ~/Ton/fin/.env · online: .env-fin um nível acima da pasta pública)

# Banco MySQL/MariaDB (Hostinger)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# Login com Google (Google Cloud → Credenciais → ID do cliente OAuth "Aplicativo da Web")
# Retornos autorizados: http://localhost:8788/api/auth/retorno.php e https://fin.toncamargo.com.br/api/auth/retorno.php
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Contas que podem entrar (separe por vírgula)
FIN_EMAILS=
